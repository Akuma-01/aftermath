{
  "name": "aftermath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:core": "vitest run tests/contracts.test.ts tests/domain.test.ts tests/fixtures.test.ts",
    "test:graph": "vitest run tests/graph.test.ts tests/diagnostics.test.ts",
    "test:storage": "vitest run tests/storage.test.ts tests/integration.test.ts",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:repair": "vitest run tests/jobs.test.ts tests/queue.test.ts tests/worker.test.ts",
    "test:api": "vitest run tests/api.test.ts tests/mcp.test.ts tests/api-startup.test.ts",
    "test:web": "playwright test",
    "test:agents": "vitest run tests/agents.test.ts tests/provider.test.ts tests/agent-graph-tools.test.ts tests/agent-api.test.ts",
    "test:web:agents": "playwright test --config playwright.agents.config.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:evaluation": "vitest run tests/evaluation.test.ts tests/benchmarks.test.ts tests/diagnostic-evaluation.test.ts tests/benchmark-cli.test.ts",
    "benchmark:diagnostics": "tsx scripts/benchmark-diagnostics.ts",
    "test:acceptance": "vitest run tests/live-recovery.test.ts tests/agent-diagnostics.test.ts tests/release.test.ts",
    "test:agents:live": "tsx scripts/test-agents-live.ts",
    "verify:workspace": "tsx scripts/verify-workspace.ts"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@xyflow/react": "12.12.0",
    "bullmq": "6.3.8",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "falkordb": "6.6.2",
    "falkordblite": "0.3.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.48.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "node": "22.23.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@falkordblite/linux-x64": "8.2.3-falkordb.4.16.3"
  }
}
