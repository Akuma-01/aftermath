# API and worker load this configuration through dotenv.
# API defaults to durable local PGlite and private FalkorDB/Redis engines.
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data

# Required shared services for npm run worker.
# In-process deterministic tests use embedded engines instead.
# DATABASE_URL=postgresql://aftermath:aftermath@127.0.0.1:5433/aftermath
# FALKORDB_URL=redis://127.0.0.1:6380
# QUEUE_REDIS_URL=redis://127.0.0.1:6381
# QUEUE_NAME=aftermath-repair

# Optional server-only live provider settings for the agent milestone.
# Leave unconfigured for deterministic development and tests.
# LLM_PROVIDER=gemini
# LLM_MODEL=
# GEMINI_API_KEY=
# GEMINI_API_KEY_FALLBACK=
# OPENAI_API_KEY=
# AGENT_MAX_CALLS=12
# AGENT_MAX_OUTPUT_TOKENS=4096
# AGENT_MAX_CONTEXT_BYTES=64000
# AGENT_CALL_TIMEOUT_MS=45000
